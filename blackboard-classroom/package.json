{
  "name": "blackboard-classroom",
  "version": "0.1.0",
  "private": true,
  "description": "Live classroom blackboard server for the Modern AI Pro multiagents-v2 hands-on workshop.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "seed": "tsx scripts/seed-tasks.ts",
    "tokens": "tsx scripts/generate-tokens.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
